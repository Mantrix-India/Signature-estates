# ── Database (Neon) ─────────────────────────────────────────────
# Direct (non-pooled) connection string, shared with the ai-service.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-long-random-string"
JWT_REFRESH_SECRET="change-me-another-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ──────────────────────────────────────────────────────
PORT=5000
# CRM frontend origin (unchanged — applies to every /api route except /api/public)
CORS_ORIGIN="http://localhost:3000"
# Number of proxy hops in front of the API. 1 on Render/Railway, empty locally.
TRUST_PROXY=

# ── Cloudinary ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── AI service ──────────────────────────────────────────────────
AI_SERVICE_URL="http://localhost:8000"

# ── Public website (/api/public) ────────────────────────────────
# Comma-separated browser origins allowed on /api/public ONLY.
PUBLIC_SITE_ORIGINS="http://localhost:3001,https://signatureestates.in"
# Shared secret the website SERVER sends as X-Public-Api-Key. Must equal the
# website's PUBLIC_API_KEY. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_API_KEY=""
# round_robin (active AGENT users) | default_agent
WEBSITE_LEAD_ASSIGNMENT="round_robin"
# User id used by default_agent, and as fallback when no active AGENT exists.
WEBSITE_DEFAULT_AGENT_ID=""
PUBLIC_ENQUIRY_LIMIT_PER_HOUR=5
PUBLIC_READ_LIMIT_PER_MINUTE=120
